{
  "name": "pr2video",
  "version": "0.1.0",
  "description": "Turn a pull request into a narrated tour of the app: an rrweb replay with captions and voice, and an MP4.",
  "keywords": [
    "pull-request",
    "video",
    "rrweb",
    "tour",
    "code-review"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pr2video": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pr2video/tour": "workspace:*",
    "@pr2video/voice": "workspace:*",
    "@pr2video/player": "workspace:*",
    "@pr2video/sandbox": "workspace:*",
    "@pr2video/recorder": "workspace:*"
  },
  "peerDependencies": {
    "kokoro-js": "^1.2.0",
    "playwright": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "kokoro-js": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "playwright": "catalog:"
  }
}
