{
  "name": "pr2video",
  "version": "0.0.5",
  "description": "Make a narrated video tour of a web app - of a pull request, a change or a feature: an rrweb replay with captions and a free local voice, as HTML or MP4.",
  "keywords": [
    "pull-request",
    "video",
    "rrweb",
    "tour",
    "code-review"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zhjch05/pr2video#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhjch05/pr2video.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/zhjch05/pr2video/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pr2video": "./dist/cli.js"
  },
  "files": [
    "dist",
    "image",
    "skills",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/bundle.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "catalog:"
  },
  "peerDependencies": {
    "kokoro-js": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "kokoro-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pr2video/tour": "workspace:*",
    "@pr2video/voice": "workspace:*",
    "@pr2video/player": "workspace:*",
    "@pr2video/sandbox": "workspace:*",
    "@pr2video/recorder": "workspace:*",
    "esbuild": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
