{
  "name": "@pr2video/tour",
  "version": "0.1.0",
  "description": "The pr2video tour format and its timeline: pacing, zoom and captions for narrated rrweb tours.",
  "keywords": [
    "pull-request",
    "video",
    "rrweb",
    "tour",
    "code-review"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zhjch05/pr2video#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhjch05/pr2video.git",
    "directory": "packages/tour"
  },
  "bugs": {
    "url": "https://github.com/zhjch05/pr2video/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "pr2video-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
