{
  "name": "pr2video-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check-types": "pnpm -r run check-types",
    "test": "pnpm --filter @pr2video/player run build && pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pr2video": "node --conditions=pr2video-source packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
